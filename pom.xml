<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.uncorrelated</groupId>
    <artifactId>editmdtable</artifactId>
    <version>0.4</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
	<maven.compiler.source>1.8</maven.compiler.source>        
	<maven.compiler.target>1.8</maven.compiler.target>
	<exec.mainClass>com.github.uncorrelated.editmdtable.Main</exec.mainClass>
    </properties>

    <build>
	<resources>
	    <resource>
		<directory>src/main/resources</directory>
		<filtering>true</filtering>
		<includes>
		    <include>**/*.properties</include>
		</includes>
	    </resource>
	    <resource>
		<directory>src/main/resources</directory>
		<filtering>false</filtering>
		<excludes>
		    <exclude>**/*.properties</exclude>
		</excludes>
	    </resource>
	</resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
	<profile>
	    <id>release</id>
	    <build>
		<plugins>
		    <!-- デバッグ情報を削除 -->
		    <plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-compiler-plugin</artifactId>
			<version>3.13.0</version>
			<configuration>
			    <debug>true</debug>
			    <debuglevel>none</debuglevel>
			</configuration>
		    </plugin>
		    <!-- jarファイルの作成方法 -->
		    <plugin>
			<artifactId>maven-assembly-plugin</artifactId>
			<version>3.6.0</version>
			<configuration>
			    <appendAssemblyId>false</appendAssemblyId>
			    <descriptorRefs>
				<descriptorRef>jar-with-dependencies</descriptorRef>
			    </descriptorRefs>
			    <archive>
				<manifest>
				    <mainClass>com.github.uncorrelated.editmdtable.Main</mainClass> 
				</manifest>
			    </archive>
			</configuration>
			<executions>
			    <execution>
				<id>make-assembly</id>
				<phase>package</phase> 
				<goals>
				    <goal>single</goal>
				</goals>
			    </execution>
			</executions>
		    </plugin>
		</plugins>
	    </build>
	</profile>
    </profiles>

</project>